<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <!-- Reading progress -->
  <div class="reading-progress">
    <div class="bar" id="progress-bar"></div>
  </div>

  <%- include('../partials/nav') %>

  <main class="article-body">
    <div class="container" style="max-width: 780px;">

      <!-- Breadcrumb -->
      <div class="reveal" style="padding-top: 100px; margin-bottom: 24px;">
        <a href="/library" style="font-size: 0.85rem; color: var(--text-muted); display: inline-flex; align-items: center; gap: 6px; transition: color 0.2s;">
          ← Library
        </a>
        <span style="color: var(--text-dim); margin: 0 8px;">/</span>
        <span style="color: var(--text-dim); font-size: 0.85rem;"><%= article.tag %></span>
      </div>

      <!-- Header -->
      <div class="article-header reveal">
        <div class="article-meta">
          <span class="tag tag-<%= article.tag.toLowerCase() %>"><%= article.tag %></span>
          <span class="tag" style="background: var(--surface); color: var(--text-muted);"><%= article.type %></span>
        </div>

        <h1><%= article.title %></h1>
      </div>

      <!-- Hero image -->
      <% if (article.imageUrl) { %>
        <div class="article-hero-img reveal" style="margin-bottom: 40px;">
          <img src="<%= article.imageUrl %>" alt="<%= article.title %>" loading="lazy">
        </div>
      <% } %>

      <!-- What the law says -->
      <div class="body-section reveal">
        <div class="section-label">
          <span class="dot" style="background: var(--amber);"></span>
          <span>What the law says</span>
        </div>
        <p><%= article.description %></p>
      </div>

      <!-- What this means for you -->
      <div class="body-section reveal">
        <div class="section-label">
          <span class="dot" style="background: var(--green);"></span>
          <span>What this means for you</span>
        </div>
        <p><%= article.summary %></p>

        <div style="margin-top: 20px;">
          <ul style="list-style: none;">
            <li style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px;">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--amber-dim); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.7rem; font-weight: 700; color: var(--amber);">1</span>
              <span style="font-size: 0.9rem; color: var(--text-secondary);">Always demand a formal written notice before acknowledging any changes.</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px;">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--amber-dim); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.7rem; font-weight: 700; color: var(--amber);">2</span>
              <span style="font-size: 0.9rem; color: var(--text-secondary);">Document all communications in case of a dispute.</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px;">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--amber-dim); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.7rem; font-weight: 700; color: var(--amber);">3</span>
              <span style="font-size: 0.9rem; color: var(--text-secondary);">Seek legal counsel if your rights are violated.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Share -->
      <div class="card reveal" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; margin-top: 32px;">
        <span class="text-muted" style="font-size: 0.85rem;">Share this resource</span>
        <div style="display: flex; gap: 8px;">
          <button class="btn-icon btn-outline" style="font-size: 0.7rem; font-weight: 700;">TT</button>
          <button class="btn-icon btn-outline" style="font-size: 0.7rem; font-weight: 700;">IG</button>
          <button class="btn-icon btn-outline" style="font-size: 0.7rem; font-weight: 700;">YT</button>
        </div>
      </div>

      <!-- Related -->
      <% if (related.length > 0) { %>
        <div style="margin-top: 48px; border-top: 1px solid var(--border); padding-top: 32px;" class="reveal">
          <h3 style="font-size: 1.1rem; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            📚 Related
          </h3>
          <div class="grid-2">
            <% related.forEach(function(r) { %>
              <a href="/article/<%= r.id %>" class="card" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
                <div>
                  <span class="tag tag-<%= r.tag.toLowerCase() %>" style="margin-bottom: 8px;"><%= r.tag %></span>
                  <h4 style="font-size: 0.9rem; margin-top: 8px;"><%= r.title %></h4>
                  <p class="text-dim" style="font-size: 0.8rem; margin-top: 4px; line-clamp: 2;"><%= r.summary %></p>
                </div>
                <span class="arrow" style="flex-shrink: 0;">→</span>
              </a>
            <% }); %>
          </div>
        </div>
      <% } %>

    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    // Reading progress
    window.addEventListener('scroll', () => {
      const bar = document.getElementById('progress-bar');
      const scrollTop = document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = (scrollTop / scrollHeight) * 100;
      bar.style.width = progress + '%';
    });
  </script>
</body>
</html>
